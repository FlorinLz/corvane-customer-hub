{
  "name": "customer-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:e2e-issues": "NEXT_DIST_DIR=.next-e2e-issues next dev -p 3101",
    "postinstall": "prisma generate",
    "build": "next build",
    "vercel-build": "bash scripts/vercel-build.sh",
    "build:e2e-zones": "NEXT_DIST_DIR=.next-e2e-zones next build",
    "build:e2e-skew": "NEXT_DIST_DIR=.next-e2e-skew next build",
    "build:e2e-roles": "NEXT_DIST_DIR=.next-e2e-roles next build",
    "start": "next start",
    "start:e2e-zones": "NEXT_DIST_DIR=.next-e2e-zones next start -p 3102",
    "start:e2e-skew": "NEXT_DIST_DIR=.next-e2e-skew next start -p 3103",
    "start:e2e-roles": "NEXT_DIST_DIR=.next-e2e-roles next start -p 3104",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:reset": "tsx scripts/db-reset.ts",
    "db:seed": "tsx prisma/seed/index.ts",
    "demo:reset-data": "tsx scripts/demo-reset-data.ts",
    "neon:rebuild-sql": "tsx scripts/write-neon-rebuild.ts",
    "gleif:snapshot": "tsx scripts/gleif-snapshot.ts",
    "gleif:check": "tsx scripts/gleif-check.ts",
    "seed:check": "vitest run tests/unit/seed/seed.test.ts",
    "test:all": "bash scripts/test-all.sh"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "i18n-iso-countries": "^7.14.0",
    "lucide-react": "^1.51.0",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "prisma": "^7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "dotenv": "^18.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
