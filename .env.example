# Runtime connection (hub_app role). Locally this can point at the
# docker-compose Postgres, or at a hosted Postgres such as Neon.
DATABASE_URL=postgresql://hub_app:hub_app@localhost:5432/customer_hub

# Optional. A direct (non-pooler) URL for the same database and role as DATABASE_URL. When DATABASE_URL is a Neon
# "-pooler" URL, the Production build's migration check uses this one instead (Prisma Migrate cannot use a pooler).
DATABASE_DIRECT_URL=

# Migrations, seed and the demo's own restore (idle rule, daily cron; hub_owner
# role). Not read by the running app outside those paths.
DATABASE_ADMIN_URL=postgresql://hub_owner:hub_owner@localhost:5432/customer_hub

# Shows the demo strip and "View as"; enables auto sign-in and the idle
# restore (20 minutes without changes). When false, /api/demo/* returns 404.
DEMO_MODE=true

# Private copy of the demo data per visitor, for 24 hours (one Postgres schema each). Needs DEMO_MODE=true, DATABASE_ADMIN_URL and the migration
# 20261015090000_demo_sandbox. Unset or false: the shared demo with the idle restore.
DEMO_SANDBOXES=false
# Ready sandboxes kept for new visitors, and the most that exist at once. Past the maximum a visitor uses the shared demo.
DEMO_SANDBOX_SPARES=2
DEMO_SANDBOX_MAX=100

# Session user when no ch_user cookie is set (DEMO_MODE only).
DEMO_DEFAULT_USER_EMAIL=adrian.koh@corvane.example

# ISO instant where today() starts (src/lib/dates.ts), running forward in
# real time from there. Ignored in production unless DEMO_MODE=true, which
# lets the live interview demo pin its own date (milestone 8 decision).
DEMO_CLOCK_START=

# Optional. A real ISO timestamp recorded once, just before the interview.
# Makes the DEMO_CLOCK_START offset a fixed constant instead of each
# serverless instance's own cold-start time, so every instance shows the
# same "now" even if one cold-starts mid-demo. See README "Demo runbook".
# Ignored when DEMO_CLOCK_START is unset.
DEMO_CLOCK_ANCHOR=

# The daily restore's password (Vercel Cron, 03:00 UTC). Vercel sends it as
# "Authorization: Bearer <value>" to /api/cron/demo-restore; any other request
# gets 401, and so does every request while this is unset. 16+ random characters.
CRON_SECRET=

# HMAC key for the ch_user session cookie. 32+ random characters.
SESSION_SECRET=

# Definition of "today" and business days.
APP_TIMEZONE=Europe/Bucharest

# GLEIF lookups (wizard, Refresh from GLEIF).
GLEIF_BASE_URL=https://api.gleif.org/api/v1
GLEIF_TIMEOUT_MS=5000
GLEIF_CACHE_PATH=data/gleif-cache.json
GLEIF_FORCE_CACHE=false
GLEIF_SEED_SOURCE=live-with-fallback

# Approved hosts for evidence, contract and agreement links (comma-separated).
APPROVED_DOC_HOSTS=docs.corvane-internal.example

# Trigram similarity threshold for the duplicate-name check (M2 AC10).
DUPLICATE_NAME_THRESHOLD=0.85
